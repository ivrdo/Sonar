// Dev Container
// Ovo nam olakšava život, instalira u stvorenom okruženju node i wasp.
{
  "name": "sonar (Wasp)",
  "dockerComposeFile": ["../compose.yaml", "compose.yaml"],
  "service": "workspace",
  "runServices": ["db", "workspace"],
  "workspaceFolder": "/workspace",
  "remoteUser": "node",
  // Verzije Nodea i Waspa su zadane u setup.sh. Bez terminala (< /dev/null)
  // skripta preskače migracije i probne podatke, da ne zapne na pitanju za ime
  // migracije.
  "postCreateCommand": "bash setup.sh < /dev/null",
  // Portove 3000 i 3001 već objavljuje .devcontainer/compose.yaml
  "otherPortsAttributes": { "onAutoForward": "ignore" }
}