# Za razvoj nijedna varijabla nije potrebna i .env ne treba postojati.
# Sve su opcionalne; kopirati u .env samo one koje treba promijeniti.

# Lozinka korisnika postgres (zadano: dev). Ako se promijeni, ista lozinka mora
# biti i u wasp/.env.server, a stari volumen baze treba obrisati: docker compose down -v
DB_PASSWORD=

# Samo za produkciju (profil prod: servisi server i caddy); tamo su obavezne
JWT_SECRET=
PUBLIC_CLIENT_URL=
PUBLIC_API_URL=
